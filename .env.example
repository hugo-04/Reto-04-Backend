# --- Base de datos MySQL ---------------------------------------------------
# Estas variables las usa docker-compose.yml para crear el contenedor
# (MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD)
# y las usa el backend (application.yml) para conectarse a la misma base.
DB_HOST=localhost
# Puerto publicado en tu equipo. Se usa 3307 para no chocar con un MySQL local en el 3306.
DB_PORT=3307
DB_NAME=customers_db
DB_USER=customers_user
DB_PASSWORD=customers_pass
# Solo la usa el contenedor de MySQL (administración)
DB_ROOT_PASSWORD=root_pass

# --- Backend (Spring Boot) -------------------------------------------------
SERVER_PORT=8080
# Orígenes permitidos por CORS, separados por coma (URL del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

